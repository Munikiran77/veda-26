# Environment variables template for SkillBridge
# Copy this file to .env and adjust values for your local environment.

# PostgreSQL Connection String (Required)
# SkillBridge supports any PostgreSQL database via Prisma ORM.
#
# OPTION A (Recommended for Judges - No local installation needed):
# Use a remote PostgreSQL instance (e.g. Neon at https://neon.tech, Supabase,
# or a database connection string provided by the organizers).
# Example: DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
#
# OPTION B (Local PostgreSQL):
# If you have PostgreSQL installed and running locally:
# Example: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillbridge?schema=public"
DATABASE_URL="your_postgresql_connection_string"

# Authentication secret for signing session cookies (Required)
# Any random 32+ character string for local evaluation
AUTH_SECRET="your_local_auth_secret_32_characters_minimum"

# Supabase Storage Configuration (Private File Bucket: skillbridge-files)
# Supabase project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Service Role Key (Server-side ONLY. NEVER expose with NEXT_PUBLIC_ or send to browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Production Application URL (Optional in dev, recommended in production for CSRF and canonical links)
# Example: https://skillbridge.vercel.app or https://your-domain.com
APP_URL="https://your-production-domain.example"
